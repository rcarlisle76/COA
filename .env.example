# Email Configuration
# Copy this file to .env and fill in your email settings

# Email service (gmail, outlook, yahoo, etc.)
EMAIL_SERVICE=gmail

# Your email address (the one that will send notifications)
EMAIL_USER=your-email@gmail.com

# Your email password or app password
# For Gmail, you MUST use an App Password, not your regular password
# See: https://support.google.com/accounts/answer/185833
EMAIL_PASS=your-app-password-here

# Where to send contact form notifications
EMAIL_TO=coabillings@gmail.com

# Server port (optional)
PORT=3000

# Google Places API (for live Google Reviews on homepage)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
