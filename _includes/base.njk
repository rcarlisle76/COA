<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or 'Expert medical insurance claims auditing in Marietta, GA. COA Auditing helps patients recover out-of-pocket expenses. Call (470) 210-8342.' }}">
    <title>{{ title }} | COA Auditing</title>
    <link rel="canonical" href="https://www.coaauditing.com{{ page.url }}">
    <meta property="og:title" content="{{ title }} | COA Auditing">
    <meta property="og:description" content="{{ description or 'Expert medical insurance claims auditing in Marietta, GA.' }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.coaauditing.com{{ page.url }}">
    <meta property="og:site_name" content="COA Auditing">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://www.coaauditing.com/images/coa-logo-full.png">
    <meta property="og:image" content="https://www.coaauditing.com/images/coa-logo-full.png">
    <meta property="og:image:width" content="1000">
    <meta property="og:image:height" content="575">
    <meta property="og:image:alt" content="COA Auditing logo">
    {% if schema %}<script type="application/ld+json">{{ schema | safe }}</script>{% endif %}
    <link rel="icon" href="/images/favicon-64.png" type="image/png">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="/" aria-label="COA Auditing home"><img src="/images/coa-logo.png" alt="COA Auditing" class="nav-logo" width="101" height="52"></a>
            </div>
            <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <ul class="nav-menu" id="nav-menu">
                <li><a href="/#home">Home</a></li>
                <li><a href="/#services">Services</a></li>
                <li><a href="/#about">About</a></li>
                <li><a href="/mission/"{% if page.url == '/mission/' %} aria-current="page"{% endif %}>Mission</a></li>
                <li><a href="/#testimonials">Testimonials</a></li>
                <li><a href="/#faq">FAQ</a></li>
                <li><a href="/blog/"{% if page.url.startsWith('/blog/') %} aria-current="page"{% endif %}>Blog</a></li>
                <li><a href="/#contact" class="nav-cta">Contact Us</a></li>
            </ul>
        </div>
    </nav>

    {{ content | safe }}

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <img src="/images/coa-logo-white.png" alt="COA Auditing" class="footer-logo" width="124" height="64">
                    <p class="footer-tagline">Accurate billing. Real recovery. Healthier outcomes.</p>
                </div>
                <div>
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/#services">Services</a></li>
                        <li><a href="/mission/">Our Mission</a></li>
                        <li><a href="/#faq">FAQ</a></li>
                        <li><a href="/blog/">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Contact</h4>
                    <ul>
                        <li>Marietta, GA</li>
                        <li><a href="tel:+14702108342">(470) 210-8342</a></li>
                        <li><a href="mailto:coabillings@gmail.com">coabillings@gmail.com</a></li>
                        <li>Mon&ndash;Fri, 8:00 AM &ndash; 5:00 PM EST</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 COA Auditing. All rights reserved.</p>
                <p>Professional medical claims auditing services. HIPAA compliant and confidential.</p>
            </div>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>
